# Copy this file to .env.docker and replace every password.
# Used by: docker compose --env-file .env.docker up -d
#
# These values are for the optional MySQL 8 container only.
# The backend reads its own configuration from backend/.env.

MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_DATABASE=netpulse_ai
MYSQL_USER=netpulse
MYSQL_PASSWORD=replace-with-a-strong-netpulse-password

# Host ports. 3307 avoids a collision with an installed MySQL on 3306.
MYSQL_HOST_PORT=3307
PHPMYADMIN_HOST_PORT=8081
