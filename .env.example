# API server
PORT=8787
HOST=127.0.0.1
DTCW_DB_PATH=server/data/dtcw.sqlite

# production enables Secure cookies, HSTS and strict startup validation.
NODE_ENV=development

# Reverse proxy handling. Leave false when the API is directly exposed: trusting
# every proxy lets clients forge X-Forwarded-For, which defeats rate limiting and
# audit attribution. Behind a proxy, use a hop count (1) or a trusted subnet.
TRUST_PROXY=false

# Canonical public origin used by the CSRF origin check, e.g. https://app.example.com.
PUBLIC_ORIGIN=

# Extra allowed browser origins (comma separated). Development adds localhost:5173.
APP_ORIGINS=

# Demo accounts. Seeded only when the database has no workspaces. In production,
# SEED_DEMO_USERS must be explicitly true and DEMO_PASSWORD must not be the
# published default.
SEED_DEMO_USERS=true
DEMO_PASSWORD=TwinDemo!2026

# Production bootstrap used instead of demo accounts. Only runs when no users exist.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace Owner
BOOTSTRAP_ADMIN_ORG=Workspace

# Self-service signup defaults to on outside production and off in production.
# Production signups additionally require SIGNUP_INVITE_CODE.
ALLOW_SELF_SIGNUP=true
SIGNUP_INVITE_CODE=

# Rate limits and password hashing.
AUTH_RATE_LIMIT=100
LOGIN_RATE_LIMIT=100
REGISTER_RATE_LIMIT=100
GLOBAL_RATE_LIMIT=10000
SENSITIVE_RATE_LIMIT=60
BCRYPT_COST=10

# Sessions and storage quotas.
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=8
REMEMBER_DAYS=7
MAX_SESSIONS_PER_USER=20
MAX_WORKSPACE_BYTES=4500000
MAX_DB_BYTES=536870912
MAX_WORKSPACES=1000

# Audit retention applies only to pre-migration rows without a hash chain.
# Hashed rows are retained so verification remains possible.
AUDIT_RETENTION_DAYS=365
AUDIT_HMAC_KEY=

# HTTP server timeouts.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Live telemetry ingestion
# ---------------------------------------------------------------------------
# Events arrive at POST /api/telemetry/ingest with either a signed-in session
# that has hunter:write or a workspace-scoped bearer token created in
# Settings → Security & access. The stream is served at GET /api/telemetry/stream.
TELEMETRY_JSON_LIMIT=2mb
TELEMETRY_MAX_BATCH=500
TELEMETRY_MAX_EVENTS=50000
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_TRAIN_MAX=5000
INGEST_RATE_LIMIT=240
INGEST_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# ML anomaly detection
# ---------------------------------------------------------------------------
# An isolation forest is trained per workspace on stored telemetry. Model trees
# live in memory and are rebuilt lazily after a restart; metadata and per-event
# scores are persisted in SQLite. No configuration is required.

# ---------------------------------------------------------------------------
# Natural-language HUNTER assistant
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. When HUNTER_LLM_BASE_URL is
# empty the API returns 503 assistant_not_configured instead of a canned answer.
# Examples:
#   OpenAI      https://api.openai.com/v1
#   Ollama      http://127.0.0.1:11434/v1
#   vLLM        http://127.0.0.1:8000/v1
HUNTER_LLM_BASE_URL=
HUNTER_LLM_API_KEY=
HUNTER_LLM_MODEL=gpt-4o-mini
HUNTER_LLM_TIMEOUT_MS=45000
HUNTER_LLM_MAX_TOKENS=900
HUNTER_ASSISTANT_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Live threat intelligence
# ---------------------------------------------------------------------------
# RDAP registration lookups are keyless and always available. AbuseIPDB adds IP
# reputation and AlienVault OTX adds pulse context when their keys are present.
# Provider failures are reported honestly; no verdict is invented.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
INTEL_TIMEOUT_MS=10000
INTEL_CACHE_MINUTES=60
INTEL_USER_AGENT=DTCW-HUNTER/1.0 (defensive threat intelligence)

# Optional build-time prefill for a local demo only. Never set these for a
# public production build: Vite embeds VITE_* values in the JavaScript bundle.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
