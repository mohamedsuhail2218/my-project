{
  "name": "digital-twin-cyber-war",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:prod": "cross-env NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run build && npm run test"
  },
  "dependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "effect": "4.0.5",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "prisma": "8.0.0-rc.33",
    "supertest": "^7.3.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5",
    "effect": "4.0.5"
  }
}
